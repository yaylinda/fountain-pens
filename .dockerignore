# Dependencies
node_modules/

# Build output (we build inside Docker)
dist/

# Development files
.git/
.gitignore
*.md
!README.md

# IDE
.vscode/
.idea/
*.swp
*.swo

# Exclude tooling, but include the swatch reference imported by the frontend.
scripts/*
!scripts/output.json

# Local data (production uses mounted volume)
data/
src/data/

# Environment files
.env*
!.env.example

# Test files
*.test.*
*.spec.*
__tests__/
coverage/

# Misc
.DS_Store
*.log
